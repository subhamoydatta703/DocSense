# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@db:5432/docsense?schema=public"
WORKER_DATABASE_URL="postgresql://postgres:postgres@db:5432/docsense?schema=public"

# Redis Config (standardized names)
REDIS_URL="redis://redis:6379"
BULLMQ_REDIS_URL="redis://redis:6379"

# Clerk Authentication (backend-only)
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# S3 Object Storage Config (backend-only)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME="docsense-bucket"

# Google AI Config (backend-only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_API_KEY=your_gemini_embedding_api_key_here
GEMINI_QUERY_API_KEY=your_gemini_query_api_key_here
GEMINI_GUARD_API_KEY=your_gemini_guard_api_key_here
# Worker can run in this process or as a separate always-running service.
RUN_WORKER=true
# Minimum interval between embedding calls per process; tune to the project's quota.
EMBEDDING_MIN_INTERVAL_MS=1000
# Exact frontend origins, separated by commas (no trailing slash).
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Frontend Config (Baked into build during Docker Compose build)
VITE_API_URL="http://localhost:5000/api"
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
